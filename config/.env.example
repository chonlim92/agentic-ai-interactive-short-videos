# Environment Configuration
# Copy this file to .env and fill in your values

# LLM (for script generation, scene planning)
# LLM_PROVIDER: anthropic, openai, or huggingface
LLM_PROVIDER=huggingface
ANTHROPIC_API_KEY=sk-ant-your_key_here
OPENAI_API_KEY=sk-your_key_here
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# HuggingFace
HUGGINGFACE_API_TOKEN=hf_your_token_here
HUGGINGFACE_MODEL=cogvideox-5b


# BytePlus Ark (for Seedance 2.0)
ARK_API_KEY=your_key_here

# LaoZhang AI — Seedream image generation (default group token)
# Supports: seedream-4-0-250828, seedream-4-5-251128, seedream-5-0-260128
LAOZHANG_API_KEY=sk-your_key_here
SEEDREAM_MODEL=seedream-5-0-260128

# LaoZhang AI — Seedance 2.0 video generation (SeeDance2 group token)
# Models: doubao-seedance-2-0-260128, doubao-seedance-2-0-fast-260128
LAOZHANG_SEEDANCE_API_KEY=sk-your_seedance2_group_key_here

# Audio Generation
AUDIO_MODEL=facebook/musicgen-medium

# Video Generation
VIDEO_MODEL=seedance2.0
VIDEO_LENGTH=60
VIDEO_OUTPUT_DIR=data/episodes
VIDEO_QUALITY=standard
VIDEO_FPS=24
VIDEO_RESOLUTION=720p

# Website
SITE_URL=http://localhost:3000
SITE_DEPLOY_TOKEN=

# Voting
VOTE_DEADLINE_HOURS=72

# Admin
ADMIN_DEFAULT_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TIMEOUT_HOURS=24
